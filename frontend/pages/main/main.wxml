<!-- 第一部分 -->
<slide-verify wx:if="{{showVerify}}" enable-close="{{true}}" bind:onsuccess="verifySuccess" bind:onerror="verifyError" bind:onclose="verifyClose" />
<!-- 登录 -->

<view wx:if="{{islogin==1}}">
  <view class="header">
    <view class="image"><image src="/icon/logo.png"/></view>
    <view>
      <view class="title">传奇影园YYDS</view>
    <view class="info">Please Login Your Account</view>
    </view>
  </view>
</view>
<!-- 找回密码 -->
<view wx:elif="{{islogin==2}}">
  <view class="header">
    <view class="title">传奇影园YYDS</view>
    <view class="info">Retrieve the password</view>
  </view>
</view>
<!-- 注册页面 -->
<view wx:else="{{islogin==3}}">
  <view class="header">
    <view class="title">传奇影园YYDS</view>
    <view class="info">Please Register Your Account</view>
  </view>
</view>

<!-- 第二部分 -->
<!-- 登录 -->
<form wx:if="{{islogin==1}}" bindsubmit="submitLogin">
  <view class="input1">
    <input type="number" class="one"  name="telephone" maxlength="11" placeholder="请输入手机号"value="{{strloginUser}}"/>
    <input password="true" class="one" name="password"placeholder="请输入密码" value="{{strloginPassword}}"/>

  </view>
  <view class="remember">
    <switch type="checkbox" checked="{{switchChecked}}" bindchange="bindswitchchange" bindswitcheck="bindswitchecked">记住密码</switch>
  </view>
  <radio-group name="type" class="radio-group">
        <label class="radio">
            <radio value="1" checked="true"  />普通游客
        </label>
        <label class="radio">
            <radio value="2"/>会员
        </label>
        <label class="radio">
            <radio value="3"  />管理员
        </label>
    </radio-group>
  <button class="btn" type="primary" form-type="submit" loading="{{submitting}}" disabled="{{submitting || showVerify}}">登录</button>
</form>
<!-- 找回密码 -->
<view wx:elif="{{islogin==2}}">
  <view class="input1">
    <input type="number" class="one" bindinput="compass" maxlength="11" placeholder="请输入手机号" value="{{strloginUser}}"/>
    <button class="two" type="primary" color="#3d7ef9" bind:tap="comebackpassword" disabled="{{loginbtnstate}}">找回密码</button>
  </view>
</view>
<!-- 注册 -->
<view wx:else="{{islogin==3}}">
  <form bindsubmit="formsubmit">
    <view class="input1">
    <input type="number" class="one" bindinput="inputiphone2" maxlength="11" placeholder="请输入手机号" value="{{strloginUser}}"/>
    <input password="true" class="one" bindinput="password2" placeholder="请输入密码" value="{{strloginPassword}}"/>
  </view>
  <button class="two" type="primary" color="#3d7ef9" form-type="submit" >注册</button>
  </form>
</view>

<!-- 第三部分 -->
<!-- 登录 -->
<view wx:if="{{islogin==1}}">
  <view class="end">
    <text bind:tap="register">注册用户</text>
    <text space="nbsp"> | </text>
    <text bind:tap="forget">忘记密码</text>
  </view>
</view>
<!-- 找回密码 -->
<view wx:elif="{{islogin==2}}">
  <view class="end">
    <text bind:tap="denglu">登录用户</text>
  </view>
</view>
<!-- 注册 -->
<view wx:else="{{islogin==3}}">
  <view class="end">
    <text bind:tap="denglu">登录用户</text>
  </view>
</view>
<view class="center">
  <view class="end-power">
  <text>Power By HDT1</text>
  </view>
</view>

