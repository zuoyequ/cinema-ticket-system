<view class="top">
  <text class="t1">购物车</text>
  <image src="/icon/yanj.png"/>
  <view class="t2" bind:tap="send" wx:for="{{shopping_cart}}" data-street="{{item.street}}"><text>{{item.street}}-{{item.address}}</text></view>
</view>
<view class="mid">
  <view class="margin"></view>
  <view class="list" wx:for="{{shopping_cart}}">
    <view class="point" bind:tap="clickDefault"  data-index="{{index}}" data-res="{{shopping_cart}}"><icon type="{{item.isDefault?'circle':'success'}}" size="20"/></view>
    <view class="item-image"><image src="{{item.url}}"/></view>
    <view class="item-text">
      <text class="item-t1">{{item.name}}</text>
      <text class="item-t2">{{item.select}}</text>
      <text class="item-t3">{{item.typee}}</text>
      <text class="item-t4">￥{{item.price}}</text>
    </view>
  </view>
</view>
<view class="bottom" wx:for="{{shopping_cart}}">
  <view class="point2" bind:tap="clickDefaultAll" data-index="{{item.id}}" data-res1="{{shopping_cart}}"><icon type="{{allDefault?'success':'circle'}}" size="20"/></view>
  <view class="b-q"><text>全选</text></view>
  <view class="b-d"><text>删除</text></view>
  <view class="b-txt"><text>合计：￥{{sum}}</text></view>
  <button class="btn" bind:tap='showInputLayer' data-index="{{item.id}}" data-id="{{id}}">结算</button>
</view>

<view wx:if="{{showPayPwdInput}}">
    <view class='bg_layer'></view>
    <view class='input_main'>
        <view class='input_title'>
            <view class='input_back' catchtap='hidePayLayer'><text></text></view>
            <text>输入支付密码</text>
        </view>
        <view class='input_tip'><text>请输入支付密码，验证通过后才可进行支付。</text></view>
        <view class='input_row' catchtap='getFocus'>
            <view class='pwd_item' wx:for='{{6}}' wx:key='item' wx:for-index='i'>
                <text wx:if='{{pwdVal.length>i}}'></text>
            </view>
        </view>
        <input wx:for="{{shopping_cart}}" class='input_control' password type='number' focus='{{payFocus}}' data-payment="{{payment}}" data-index="{{indexx}}" data-id="{{id}}"  bindinput='inputPwd' maxlength='6'/>
    </view>
</view>