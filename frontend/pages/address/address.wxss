/* pages/address/address.wxss *//* pages/address/address.wxss */
.address-none{
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90vh;
}
.none-content{
  display: flex;
  flex-direction: column;
  align-items: center;
}
.none-content image{
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}
.none-content .txt{
  font-size: 26rpx;
  color: #999;
}

.add-address{
  position: fixed;
  bottom:0;
  width: 92%;
  margin-left: 28rpx;
  border-radius: 10rpx;
  height: 90rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: rgb(90, 156, 255);
}
.add-address .txt{
  width: 60vw;
  height: 75rpx;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-origin: 5rpx;
  font-size: 30rpx;
  color: white;
}
.address-list{
  display: flex;
  flex-direction: column;
  margin-bottom: 95rpx;
}
.address-item{
  display: flex;
  flex-direction: column;
  margin:6rpx 20rpx;
  padding: 20rpx 20rpx 10rpx 20rpx;
  border-radius: 10rpx;
  background-color: #fff;
}
.item-top{
  font-size: 28rpx;
  color: black;
}
.item-content{
  font-size: 24rpx;
  color: #999;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #dcdcdc;
}
.item-bottom{
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}
.item-bottom .right{
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.item-bottom .right .txt{
  padding: 0 10rpx;
}