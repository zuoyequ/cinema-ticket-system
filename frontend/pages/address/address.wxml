<!--pages/address/address.wxml-->
<view wx:if="{{addressList.length==0}}" class="address-none">
  <view class="none-content">
    <image src="/icon/tianjiadizhi.png"/>
    <text class="txt">请添加收货地址</text>
  </view>
</view>

<view wx:else class="address-list">
  <view class="address-item" wx:for="{{addressList}}">
    <view class="item-top">{{item.name}} {{item.mobile}}</view>
    <view class="item-content">{{item.address}} {{item.street}}</view>
    <view class="item-bottom">
      <view class="left" bind:tap="clickDefault" data-index="{{index}}">
        <icon type="{{item.isDefault?'success':'circle'}}" size="15"/>    设为默认地址
      </view>
      <view class="right">
        <view class="txt" bind:tap="clickDelete" data-index="{{item.id}}">删除</view>
        <view class="txt" bind:tap="clickEdit" data-index="{{item.id}}">编辑</view>
      </view>
    </view>
  </view>
</view>

<view class="add-address" bind:tap="clickAdd">
  <view class="txt">添加收货地址</view>
</view>
