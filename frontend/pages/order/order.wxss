/* pages/order/order.wxss */
.order-notifications {
  margin: 24rpx;
  padding: 24rpx;
  background: #edf8f3;
  border-radius: 16rpx;
  color: #246447;
}
.notification-title { font-size: 28rpx; font-weight: bold; margin-bottom: 12rpx; }
.notification-message { font-size: 24rpx; line-height: 1.8; }
