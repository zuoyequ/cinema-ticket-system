.inputInfor{
  margin-top: 20rpx;
}
radio .wx-radio-input {
  width: 35rpx;
  height: 35rpx;
  border-radius: 50%;
  border: 2rpx solid #000;
  background: transparent;
}

radio .wx-radio-input.wx-radio-input-checked {
  width: 35rpx;
  height: 35rpx;
  border: 2rpx solid #000;
  background-color: white !important;/*外圈边框与内圈实心圆间的内容的颜色，不设置就默认是上面的绿色*/
}
radio .wx-radio-input.wx-radio-input-checked::before {
  width: 35rpx;
  height: 35rpx;
  border-radius: 50%;
  /* 圆角 */
  width: 20rpx;
  /* 选中后对勾大小，不要超过背景的尺寸 */
  height: 20rpx;
  /* 选中后对勾大小，不要超过背景的尺寸 */
  line-height: 20rpx;
  text-align: center;
  font-size: 0rpx;
  /* 对勾大小 30rpx */
  color: transparent;
  /* 对勾颜色 白色 */
  background: #000;
  transform: translate(-50%, -50%) scale(1);
}


/* 座位按每排九座排列，画面索引与实际座位 ID 分开保存。 */
.head { text-align: center; height: auto; padding: 20rpx 0; margin-top: 0; }
.head text { margin-left: 0; }
.left { width: 40rpx; flex-shrink: 0; margin-left: 10rpx; }
.left .row-number { height: 70rpx; line-height: 70rpx; margin: 0; text-align: center; }
.seat-box { flex: 1; display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); gap: 0; margin-right: 16rpx; }
.seat-cell { height: 70rpx; display: flex; align-items: center; justify-content: center; }
.seat-box .sImg { width: 58rpx; height: 60rpx; }
.midden { height: auto; padding-bottom: 20rpx; }
.zoomtop radio-group { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.zoomtop label { margin: 8rpx; font-size: 26rpx; }
