<view class="all" wx:for="{{get_shopping1}}">
  <view class="top"><image src="{{item.url}}" mode="widthFix"/></view>
  <view class="zi">
    <view>
      <text class="t1">￥{{item.price}}</text>
      <text class="t2">VIP ￥{{item.vip}}</text>
    </view>
    <view class="com">
      <text>{{item.name}}</text>
    </view>
  </view>
  <view class="btm">
    <view class="list">
      <view class="long">
        <text class="title">保险</text>
        <text class="in">{{baoxian}}</text>
      </view>
      <image src="/icon/xiangyou2.png" mode="aspectFit" class="you" bind:tap="send"/>
    </view>
    <view class="line"></view>
    <view class="list">
      <view class="long">
        <text class="title">选择</text>
        <text class="in">{{chose}}</text>
      </view>
      <image src="/icon/xiangyou2.png" mode="aspectFit" class="you" bind:tap="send2"/>
    </view>
    <view class="line"></view>
    <view class="list">
      <view class="long">
        <text class="title">物流</text>
        <text class="in">请选择收货地址</text>
      </view>
      <image src="/icon/xiangyou2.png" mode="aspectFit" class="you" bind:tap="getLocation"/>
    </view>
    <view class="line"></view>
    <view class="list">
      <view class="long">
        <text class="title">活动</text>
        <text class="in">先领券！首次激活领15元</text>
      </view>
      <image src="/icon/xiangyou2.png" mode="aspectFit" class="you"/>
    </view>
    <view class="line"></view>
    <view class="list">
      <view class="long">
        <text class="title">参数</text>
        <text class="in">品牌 · 生产企业名称</text>
      </view>
      <image src="/icon/xiangyou2.png" mode="aspectFit" class="you"/>
    </view>
  </view>
  <view class="pinglun">
    <view class="list">
      <view class="long">
        <text class="title2">评论</text>
        <text class="in">(276)</text>
      </view>
      <image src="/icon/xiangyou2.png" mode="aspectFit" class="you"/>
    </view>
    <view class="loud">
      <view class="yhImg"> 
        <image src="/icon/7.jpg" mode="aspectFill"/>
      </view>
      <view class="wenb">
        <text style="font-size: 25rpx;font-weight: 600;">dgfhrj</text>
        <text style="font-size: 23rpx;color: #cecfcd;margin-top: 8rpx;">2023-3-30</text>
      </view>
    </view>
    <view class="neir">
        <text>性价比高，发货速度快！</text>
    </view>
  </view>
  <view class="bottom">
    <view class="di">
      <view class="li"><image src="/icon/kefu2.png" mode="aspectFit"/><text>客服</text></view>
      <view class="li"><image src="/icon/gouw.png" mode="aspectFit" bind:tap="shoppingcart" data-address="address" data-id="{{id}}"/><text>购物车</text></view>
    </view>
    <button class="btn1" bind:tap="addshoppingcart" data-index="{{item.id}}" data-id="{{id}}" data-baoxian="{{baoxian}}" data-chose="{{chose}}">加入购物车</button>
    <button class="btn2" bind:tap="showInputLayer" data-index="{{item.id}}" data-id="{{id}}">立即购买</button>
  </view>
</view>
<view wx:if="{{showPayPwdInput}}">
    <view class='bg_layer'></view>
    <view class='input_main' wx:for="{{get_shopping1}}">
        <view class='input_title'>
            <view class='input_back' catchtap='hidePayLayer' ><text></text></view>
            <text>输入支付密码</text>
        </view>
        <view class='input_tip'><text>请输入支付密码，验证通过后才可进行支付。</text></view>
        <view class='input_row' catchtap='getFocus'>
            <view class='pwd_item' wx:for='{{6}}' wx:key='item' wx:for-index='i'>
                <text wx:if='{{pwdVal.length>i}}'></text>
            </view>
        </view>
        <input class='input_control' password type='number' focus='{{payFocus}}' bindinput='inputPwd'  data-index="{{item.id}}" data-id="{{id}}" data-payment="{{payment}}" maxlength='6'/>
    </view>
</view>
