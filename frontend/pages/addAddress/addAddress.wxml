<!--pages/addAddress/addAddress.wxml-->
<view class="weui-cells">
  <form bindsubmit="clickAdd">
    <view class="weui-cell">
    <view class="weui-label">姓名</view>
    <view class="weui-cell-bd" style="margin-left: 127rpx;">
      <input class="weui-input" name="name" placeholder="收货人姓名" value="{{address.name}}" bindinput="inputName"/>
    </view>
  </view>
  <view class="line"></view>
  <view class="weui-cell">
    <view class="weui-label">手机号</view>
    <view class="weui-cell-bd" style="margin-left: 94rpx;">
      <input class="weui-input" name="telephone" placeholder="收货人手机号" value="{{address.mobile}}" bindinput="inputMobile"/>
    </view>
  </view>
  <view class="line"></view>
  <view class="weui-cell">
    <view class="weui-label">所在地址</view>
    <view style="margin-left: 60rpx; color: #7c7c7c;">
      <picker mode="region" name="address" bindchange="bindRegionChange">
        <view>{{address.city.length>0?address.city:'请选择收货地址'}}</view>
      </picker>
    </view>
  </view>
  <view class="line"></view>
  <view class="weui-cell">
    <view class="weui-label">详细地址</view>
    <view class="weui-cell-bd" style="margin-left: 60rpx;">
      <input class="weui-input" name="street" placeholder="需要具体到街道、门牌号等" value="{{address.address}}" bindinput="inputSreet"/>
    </view>
  </view>
<view class="left" bind:tap="clickDefault" data-index="{{index}}">
  <icon type="{{address.isDefault?'success':'circle'}}" size="15"/>    设为默认地址
</view>
<view class="add-address">
<button class="txt" type="primary"  form-type="submit" >保存并使用</button>
</view>
  </form>
  </view>




