  margin-right: 10rpx;
}
 
.arrow{
  margin-top: 20rpx;
  margin-left: 500rpx;
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #999;
  border-right: 4rpx solid #999;
  /* 旋转45度 */
  transform: rotate(45deg);
  right: 30rpx;
  top: 38rpx;
}
.ddd text{
  display: flex;
  flex-direction: row;
  font-size: 30rpx;
}
.ddd image{
  width: 180rpx;
  height: 240rpx;
}

