}

.daiying{
  height: 440rpx;
  margin-top: 40rpx;
  width: 94%;
  background-color: rgb(169, 240, 216);
  margin-left: 20rpx;
}

.my_priview_md{
  display: flex;
  flex-direction: row;
  align-items: center;
}

.my_priview_md text{
  font-size: 40rpx;
  margin-top: 20rpx;
 margin-left: 20rpx;
}
 
.my_priview{
  width: 50rpx;
